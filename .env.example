# SPRING_PROFILES_ACTIVE: Define o perfil do backend Spring Boot (dev | test | prod)
SPRING_PROFILES_ACTIVE="dev"

# JWT_SECRET: Obrigatório em produção para assinatura HMAC-SHA256 dos tokens JWT (mínimo 32 caracteres / 256 bits)
JWT_SECRET="MY_32_CHAR_MINIMUM_JWT_SECRET_KEY"

# PLATFORM ADMIN BOOTSTRAP SEEDER (Provisiona o ADMIN inicial de forma segura e idempotente em test e prod)
ADMIN_BOOTSTRAP_ENABLED="true"
ADMIN_BOOTSTRAP_EMAIL="abiliodevmaster007@gmail.com"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME_ADMIN_STRONG_PASSWORD"
ADMIN_BOOTSTRAP_NAME="Administrador SegundaChance"
ADMIN_BOOTSTRAP_PHONE="+244 923 000 000"
ADMIN_BOOTSTRAP_LOCATION="Luanda"

# POSTGRESQL (Obrigatório quando SPRING_PROFILES_ACTIVE=prod)
DB_URL="jdbc:postgresql://localhost:5432/segundachance"
DB_USERNAME="segundachance_user"
DB_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"
JPA_DDL_AUTO="validate"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER: Configuração híbrida multi-provedor para o Kuenda AI
# Valores suportados: HYBRID (padrão), GEMINI, OPENAI
AI_PROVIDER="HYBRID"
GEMINI_MODEL="gemini-3.8-flash"

# OPENAI_API_KEY: Opcional para utilizar OpenAI ou modelos compatíveis no modo híbrido
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Opcional. URL base do backend Spring Boot (ex: http://localhost:8080)
VITE_API_URL=

# VITE_WS_URL: Opcional. URL de conexão do WebSocket STOMP (ex: http://localhost:8080/ws)
VITE_WS_URL=
