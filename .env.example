# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER: Configuração híbrida multi-provedor para o Spring AI / Kuenda AI
# Valores suportados: HYBRID (padrão), GEMINI, OPENAI
AI_PROVIDER="HYBRID"
GEMINI_MODEL="gemini-3.8-flash"

# OPENAI_API_KEY: Opcional para utilizar OpenAI ou modelos compatíveis no modo híbrido
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Opcional. URL base do backend Spring Boot (ex: http://localhost:8080)
VITE_API_URL=

# VITE_WS_URL: Opcional. URL de conexão do WebSocket STOMP (ex: http://localhost:8080/ws)
VITE_WS_URL=
